{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentationos.local/schemas/layout-ir/1",
  "title": "LayoutIR",
  "description": "语义布局：AI 输出语义关系，Layout Engine 计算几何（总方案 PHASE 2/8）",
  "type": "object",
  "required": ["schema", "version", "width", "height"],
  "properties": {
    "schema": { "const": "layout-ir" },
    "version": { "const": "1" },
    "width": { "type": "number", "exclusiveMinimum": 0 },
    "height": { "type": "number", "exclusiveMinimum": 0 },
    "direction": { "enum": ["row", "column"], "default": "column" },
    "gap": { "enum": ["xs", "sm", "md", "lg", "xl"], "default": "md" },
    "padding": { "type": "object", "properties": { "top": { "type": "number" }, "right": { "type": "number" }, "bottom": { "type": "number" }, "left": { "type": "number" } }, "additionalProperties": false },
    "children": {
      "type": "array",
      "items": { "$ref": "#/$defs/layoutNode" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "layoutNode": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["title", "subtitle", "text", "image", "chart", "table", "shape", "svg", "spacer", "group"] },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "anchor": { "enum": ["top-left", "top-center", "top-right", "middle-left", "center", "middle-right", "bottom-left", "bottom-center", "bottom-right"] },
        "align": { "enum": ["start", "center", "end", "stretch"] },
        "alignVertical": { "enum": ["top", "center", "bottom", "stretch"] },
        "below": { "type": "string", "description": "位于某个子节点之下（引用其 id）" },
        "rightOf": { "type": "string", "description": "位于某个子节点右侧（引用其 id）" },
        "gap": { "enum": ["xs", "sm", "md", "lg", "xl"] },
        "minWidth": { "type": "number", "exclusiveMinimum": 0 },
        "maxWidth": { "type": "number", "exclusiveMinimum": 0 },
        "minHeight": { "type": "number", "exclusiveMinimum": 0 },
        "maxHeight": { "type": "number", "exclusiveMinimum": 0 },
        "aspectRatio": { "type": "number", "exclusiveMinimum": 0 },
        "children": { "type": "array", "items": { "$ref": "#/$defs/layoutNode" } }
      },
      "additionalProperties": false
    }
  }
}
