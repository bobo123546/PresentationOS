{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentationos.local/schemas/qa/1",
  "title": "QAReport",
  "description": "QA 报告：机械/视觉/PowerPoint 检查结果（总方案 PHASE 2/9）",
  "type": "object",
  "required": ["schema", "version", "qaType", "result", "checks"],
  "properties": {
    "schema": { "const": "qa-report" },
    "version": { "const": "1" },
    "qaType": { "enum": ["mechanical", "visual", "powerpoint", "combined"] },
    "result": { "enum": ["pass", "fail", "warn"] },
    "deckRef": { "type": "string" },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "name", "status", "severity"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "enum": ["pass", "fail", "warn", "skipped"] },
        "severity": { "enum": ["info", "warning", "critical"] },
        "details": { "type": "string" },
        "target": { "type": "string", "description": "目标 slide/object 标识" },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
