{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentationos.local/schemas/presentation-ir/1",
  "title": "DeckSpec",
  "description": "整副演示文稿规范：全局元数据 + 设计令牌 + 幻灯片列表（总方案 PHASE 2）",
  "type": "object",
  "required": ["schema", "version", "title", "slides"],
  "properties": {
    "schema": { "const": "deck-spec" },
    "version": { "const": "1" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "author": { "type": "string" },
    "designTokens": { "$ref": "https://presentationos.local/schemas/design-token/1" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://presentationos.local/schemas/presentation-ir/1#/$defs/slide" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slide": {
      "type": "object",
      "required": ["id", "kind", "title", "layout", "blocks"],
      "properties": {
        "id": { "type": "string", "pattern": "^slide-[0-9]+$" },
        "kind": { "enum": ["cover", "toc", "section", "content", "data", "quote", "summary", "ending"] },
        "title": { "type": "string" },
        "layout": { "$ref": "https://presentationos.local/schemas/layout-ir/1" },
        "blocks": {
          "type": "array",
          "items": { "$ref": "#/$defs/slideBlock" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "slideBlock": {
      "oneOf": [
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/imageBlock" },
        { "$ref": "#/$defs/chartBlock" },
        { "$ref": "#/$defs/tableBlock" },
        { "$ref": "#/$defs/shapeBlock" },
        { "$ref": "#/$defs/svgBlock" }
      ]
    },
    "textBlock": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" },
        "style": { "type": "string" },
        "fontScale": { "type": "number", "minimum": 0.75, "maximum": 3 },
        "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" }
      },
      "additionalProperties": false
    },
    "imageBlock": {
      "type": "object",
      "required": ["type", "src", "alt"],
      "properties": {
        "type": { "const": "image" },
        "src": { "type": "string" },
        "alt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "chartBlock": {
      "type": "object",
      "required": ["type", "chartType", "data"],
      "properties": {
        "type": { "const": "chart" },
        "chartType": { "enum": ["bar", "line", "pie", "scatter", "column"] },
        "data": {
          "type": "object",
          "required": ["labels", "series"],
          "properties": {
            "labels": { "type": "array", "items": { "type": "string" } },
            "series": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "values"],
                "properties": {
                  "name": { "type": "string" },
                  "values": { "type": "array", "items": { "type": "number" } }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tableBlock": {
      "type": "object",
      "required": ["type", "headers", "rows"],
      "properties": {
        "type": { "const": "table" },
        "headers": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      },
      "additionalProperties": false
    },
    "shapeBlock": {
      "type": "object",
      "required": ["type", "shape", "label"],
      "properties": {
        "type": { "const": "shape" },
        "shape": { "enum": ["rect", "roundRect", "circle", "line", "arrow"] },
        "label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "svgBlock": {
      "type": "object",
      "required": ["type", "svg"],
      "properties": {
        "type": { "const": "svg" },
        "svg": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
