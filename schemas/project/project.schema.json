{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://presentationos.local/schemas/project/1",
  "title": "PresentationOS Project Specification v1",
  "type": "object",
  "required": ["schema", "version", "projectId", "title", "createdAt", "updatedAt", "sourceDocument"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "presentationos-project"
    },
    "version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"]
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceDocument": {
      "type": "object",
      "required": ["filename", "format", "content"],
      "properties": {
        "filename": { "type": "string" },
        "format": { "type": "string", "enum": ["markdown", "txt", "docx", "csv", "tsv", "xlsx", "pdf", "pptx"] },
        "sha256": { "type": "string" },
        "content": { "type": "string" }
      },
      "additionalProperties": false
    },
    "editorState": {
      "type": "object",
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "properties": {
              "speakerNotes": { "type": "string" },
              "layout": { "type": "string", "enum": ["title", "bullet_list", "two_column", "big_stat", "quote"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "compileProfile": {
      "type": "object",
      "properties": {
        "sourceAsset": {
          "type": "object",
          "required": ["path", "sha256", "filename", "markdownSha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "filename": { "type": "string", "minLength": 1, "maxLength": 240 },
            "markdownSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "referenceAsset": {
          "type": "object",
          "required": ["path", "sha256", "filename"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "filename": { "type": "string", "minLength": 1, "maxLength": 240 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "themeOverrides": { "type": "object" }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "pptxPath": { "type": ["string", "null"] },
        "qaReportPath": { "type": ["string", "null"] },
        "pdfPath": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "lastCompileState": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["IDLE", "QUEUED", "RUNNING", "COMPLETED", "FAILED", "CANCELLED"] },
        "compiledAt": { "type": ["string", "null"] },
        "durationMs": { "type": ["number", "null"] },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "allOf": [{ "if": { "properties": { "version": { "const": "1.0.0" } } }, "then": { "not": { "required": ["compileProfile"] } } }],
  "additionalProperties": false
}
