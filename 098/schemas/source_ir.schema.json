{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental Python chunk-based SourceIR",
  "type": "object",
  "required": [
    "source_id",
    "file_name",
    "sha256",
    "chunks",
    "facts"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chunk_id",
          "content_type",
          "raw_text"
        ],
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "raw_text": {
            "type": "string"
          }
        }
      }
    },
    "facts": {
      "type": "array"
    }
  }
}