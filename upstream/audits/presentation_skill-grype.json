n/vulns/tornado/PYSEC-2025-266.yaml","https://github.com/tornadoweb/tornado/releases/tag/v6.5.3"],"description":"Tornado: Quadratic DoS via Repeated Header Coalescing","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-67725","epss":0.00559,"percentile":0.45337,"date":"2026-09-20"}],"cwes":[{"cve":"CVE-2025-67725","cwe":"CWE-400","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["6.5.3"],"state":"fixed","available":[{"version":"6.5.3","date":"2026-07-21","kind":"first-observed"}]},"advisories":[],"risk":0.41925},"relatedVulnerabilities":[{"id":"CVE-2025-67725","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2025-67725","namespace":"nvd:cpe","severity":"High","urls":["https://github.com/tornadoweb/tornado/commit/771472cfdaeebc0d89a9cc46e249f8891a6b29cd","https://github.com/tornadoweb/tornado/releases/tag/v6.5.3","https://github.com/tornadoweb/tornado/security/advisories/GHSA-c98p-7wgm-6p64"],"description":"Tornado is a Python web framework and asynchronous networking library. In versions 6.5.2 and below, a single maliciously crafted HTTP request can block the server's event loop for an extended period, caused by the HTTPHeaders.add method. The function accumulates values using string concatenation when the same header name is repeated, causing a Denial of Service (DoS).  Due to Python string immutability, each concatenation copies the entire string, resulting in O(n²) time complexity. The severity can vary from high if max_header_size has been increased from its default, to low if it has its default value of 64KB. This issue is fixed in version 6.5.3.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-67725","epss":0.00559,"percentile":0.45337,"date":"2026-09-20"}],"cwes":[{"cve":"CVE-2025-67725","cwe":"CWE-400","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"tornado","version":"6.5.2"}},"found":{"vulnerabilityID":"GHSA-c98p-7wgm-6p64","versionConstraint":"<6.5.3 (python)"},"fix":{"suggestedVersion":"6.5.3"}}],"artifact":{"id":"83e31cf1d3c042ca","name":"tornado","version":"6.5.2","type":"python","locations":[{"path":"\\src\\presentation_skill\\templates\\common\\requirements.txt","accessPath":"\\src\\presentation_skill\\templates\\common\\requirements.txt","annotations":{"evidence":"primary"}}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:python-tornado:python-tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python-tornado:python_tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python_tornado:python-tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python_tornado:python_tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python-tornado:tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python_tornado:tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:tornado:python-tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:tornado:python_tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python:python-tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python:python_tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:tornado:tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python:tornado:6.5.2:*:*:*:*:*:*:*"],"purl":"pkg:pypi/tornado@6.5.2","upstreams":[]}},{"vulnerability":{"id":"GHSA-jhmp-mqwm-3gq8","dataSource":"https://github.com/advisories/GHSA-jhmp-mqwm-3gq8","namespace":"github:language:python","severity":"High","urls":["https://github.com/tornadoweb/tornado/security/advisories/GHSA-jhmp-mqwm-3gq8","https://nvd.nist.gov/vuln/detail/CVE-2025-67726","https://github.com/tornadoweb/tornado/commit/771472cfdaeebc0d89a9cc46e249f8891a6b29cd","https://github.com/pypa/advisory-database/tree/main/vulns/tornado/PYSEC-2025-267.yaml","https://github.com/tornadoweb/tornado/releases/tag/v6.5.3"],"description":"Tornado: Quadratic DoS via Crafted Multipart Parameters","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-67726","epss":0.00535,"percentile":0.44091,"date":"2026-09-20"}],"cwes":[{"cve":"CVE-2025-67726","cwe":"CWE-400","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2025-67726","cwe":"CWE-834","source":"security-advisories@github.com","type":"Secondary"}],"fix":{"versions":["6.5.3"],"state":"fixed","available":[{"version":"6.5.3","date":"2026-07-21","kind":"first-observed"}]},"advisories":[],"risk":0.40124999999999994},"relatedVulnerabilities":[{"id":"CVE-2025-67726","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2025-67726","namespace":"nvd:cpe","severity":"High","urls":["https://github.com/tornadoweb/tornado/commit/771472cfdaeebc0d89a9cc46e249f8891a6b29cd","https://github.com/tornadoweb/tornado/releases/tag/v6.5.3","https://github.com/tornadoweb/tornado/security/advisories/GHSA-jhmp-mqwm-3gq8"],"description":"Tornado is a Python web framework and asynchronous networking library. Versions 6.5.2 and below use an inefficient algorithm when parsing parameters for HTTP header values, potentially causing a DoS. The _parseparam function in httputil.py is used to parse specific HTTP header values, such as those in multipart/form-data and repeatedly calls string.count() within a nested loop while processing quoted semicolons. If an attacker sends a request with a large number of maliciously crafted parameters in a Content-Disposition header, the server's CPU usage increases quadratically (O(n²)) during parsing. Due to Tornado's single event loop architecture, a single malicious request can cause the entire server to become unresponsive for an extended period. This issue is fixed in version 6.5.3.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-67726","epss":0.00535,"percentile":0.44091,"date":"2026-09-20"}],"cwes":[{"cve":"CVE-2025-67726","cwe":"CWE-400","source":"security-advisories@github.com","type":"Secondary"},{"cve":"CVE-2025-67726","cwe":"CWE-834","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"python-matcher","searchedBy":{"language":"python","namespace":"github:language:python","package":{"name":"tornado","version":"6.5.2"}},"found":{"vulnerabilityID":"GHSA-jhmp-mqwm-3gq8","versionConstraint":"<6.5.3 (python)"},"fix":{"suggestedVersion":"6.5.3"}}],"artifact":{"id":"83e31cf1d3c042ca","name":"tornado","version":"6.5.2","type":"python","locations":[{"path":"\\src\\presentation_skill\\templates\\common\\requirements.txt","accessPath":"\\src\\presentation_skill\\templates\\common\\requirements.txt","annotations":{"evidence":"primary"}}],"language":"python","licenses":[],"cpes":["cpe:2.3:a:python-tornado:python-tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python-tornado:python_tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python_tornado:python-tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python_tornado:python_tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python-tornado:tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python_tornado:tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:tornado:python-tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:tornado:python_tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python:python-tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python:python_tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:tornado:tornado:6.5.2:*:*:*:*:*:*:*","cpe:2.3:a:python:tornado:6.5.2:*:*:*:*:*:*:*"],"purl":"pkg:pypi/tornado@6.5.2","upstreams":[]}},{"vulnerability":{"id":"GH